SECRET_KEY=replace-with-a-long-random-secret
# Default country code when hospital/request phones omit +91 (10-digit Indian mobiles).
DEFAULT_PHONE_COUNTRY=91
# Local: leave unset to use SQLite (instance/smart_bloodlink.db).
# Vercel + Neon: set automatically when you install Neon from the Vercel Marketplace (pooled).
# Manual Neon: paste the pooled connection string from the Neon Console → Connect.
DATABASE_URL=
# Required to mark hospitals as verified for real Twilio calls (dashboard "Verify hospital").
ADMIN_VERIFY_KEY=
# Leave Twilio values blank to run safely in demo mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Voice-capable Twilio number — all outbound alerts call from this Caller ID only (E.164, e.g. +17372212163).
TWILIO_PHONE_NUMBER=
# Voice delivery (default: trial script — spoken blood-request message, no /voice URL required).
# Set to production only after Twilio upgrade + working PUBLIC_BASE_URL webhooks.
TWILIO_VOICE_MODE=
# Legacy: set to 1 to label trial mode in the UI; script is on by default unless VOICE_MODE=production.
TWILIO_USE_TRIAL_VOICE=
# Set to 0 to disable the spoken trial script (falls back to /voice or demo template).
TWILIO_TRIAL_SCRIPT=1
# Optional: TWILIO_TRIAL_VOICE_URL=https://webhooks.twilio.com/v1/Voice/Template/voice_speech_recognition
# Public HTTPS base URL for Twilio webhooks (e.g. https://your-app.vercel.app).
# On Vercel, leave blank to use the auto-set VERCEL_URL, or set a custom domain here.
PUBLIC_BASE_URL=
